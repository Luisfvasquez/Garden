APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=backend_garden
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- API auth (docs/api/_convenciones.md) ---
# Hosts that receive the SPA session cookie.
SANCTUM_STATEFUL_DOMAINS=evergarden.test:5173,localhost:5173,127.0.0.1:5173
# Mobile personal-access-token lifetime, in minutes (default 30 days).
SANCTUM_TOKEN_EXPIRATION=43200
# CORS: explicit front-end origins, comma separated. Never "*".
FRONTEND_URL=http://evergarden.test:5173
FRONTEND_ORIGINS=http://evergarden.test:5173,http://localhost:5173,http://127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Content moderation: `local` (lexicon + regex, no external calls) or a hosted
# classifier later. App code depends on the ContentModerator interface only.
MODERATION_DRIVER=local

# Web Push (VAPID). Generate once, then pin here. Empty = push disabled.
VAPID_SUBJECT=mailto:hola@evergarden.test
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Real escalation for critical moderation (minor_safety / self_harm, or a
# critical report). Empty = log only, no email.
MODERATION_ALERT_EMAIL=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
